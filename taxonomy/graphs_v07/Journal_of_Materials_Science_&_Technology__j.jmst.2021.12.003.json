   "spine_primary_argument": "yes: need h1 -> hypothesis h2 -> host d1, alloy cocatalyst d2, Ag:Pd sweep d3 -> solvothermal p1 -feeds_into-> chemical reduction p2 -> dispersion s2 + Ag-Pd interaction s4 -> Schottky junction s5 (joint) -> carrier separation pr2 (explained by m1) ; s4 -> H* binding pr3 (explained by m2) ; pr2 + pr3 -> H2 rate f1 (joint) -> conclusion c1",
   "spine_nodes": 16,
   "spine_connected": true,
   "spine_claims_evidenced": "s2 (o2, o4), s4 (o7; k3), s5 basis=argued (k3; L1 qualifies), m1 basis=argued (k5 added), pr2 (o14, o15, o16; k4), pr3 (o13), m2 (o10, o13; k2), f1 (o10)",
   "v04_rules": "pass; all types, rels, mm_ops, modalities valid; every figure-bearing OBS edge carries an op",
