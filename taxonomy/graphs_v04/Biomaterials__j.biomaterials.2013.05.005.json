  },
  {
   "id": "d2",
   "type": "HYP/hypothesis",
   "label": "Curcumin micelles in a thermosensitive in-situ-gelling hydrogel give sustained local release and accelerate healing",
   "attrs": {
    "inferred": true
   },
   "figs": [],
   "modality": null,
   "provenance": null,
