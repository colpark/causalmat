 "nodes": [
  {
   "id": "d1",
   "type": "HYP/need",
   "label": "Curcumin aids wound healing but is poorly water-soluble and short-lived; topical use needs sustained local delivery",
   "attrs": {
    "inferred": true,
    "application": "cutaneous wound dressing"
   },
   "figs": [],
   "modality": null,
   "provenance": null,
