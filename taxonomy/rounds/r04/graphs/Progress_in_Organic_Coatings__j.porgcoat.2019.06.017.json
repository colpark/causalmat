 "nodes": [
  {
   "id": "q1",
   "type": "HYP/need",
   "label": "Heat-resistant silicone coatings adhere poorly and protect metal weakly against corrosion",
   "attrs": {
    "inferred": true
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": true,
   "fit": "good",
   "proposed": false
  },
  {
   "id": "q2",
   "type": "HYP/gap",
   "label": "Epoxy-silicone blends phase-separate and must be cured separately; a compatible one-step bridge is lacking",
   "attrs": {
    "inferred": true,
    "gap_kind": "unsolved problem"
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": true,
   "fit": "good",
   "proposed": false
  },
  {
   "id": "q3",
   "type": "HYP/hypothesis",
   "label": "Bridging epoxy resins to silicone through APTES (silanized epoxy resins, SERs) gives a bonded, compatible network with better adhesion and heat resistance",
   "attrs": {},
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": true,
   "fit": "good",
   "proposed": false
  },
  {
   "id": "q4",
   "type": "DES/base_system",
   "label": "Hydroxyl-terminated methyl phenyl silicone rubber (PSi) cured at room temperature with TEOS/DBTDL on tinplate",
   "attrs": {
    "material": "PSi"
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": true,
   "fit": "good",
   "proposed": false
  },
  {
   "id": "q5",
   "type": "DES/modification",
   "label": "Incorporate 18 wt% SER prepolymers made by reacting epoxy resins with excess APTES",
   "attrs": {
    "constituent": "SER (epoxy + APTES)",
    "amount": "18 wt%",
    "intended_role": "compatibiliser, adhesion, heat resistance"
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": true,
   "fit": "good",
   "proposed": false
  },
  {
   "id": "q6",
   "type": "DES/variable_sweep",
   "label": "Epoxy type: E51 (glycidyl BPA), EPOSS (cycloaliphatic POSS), GPOSS (glycidyl POSS), BEA (cycloaliphatic ester) -> S1-S4; S0 pure PSi",
   "attrs": {
    "variable": "epoxy resin structure",
    "levels": "S0 control, S1-S4"
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": false,
   "fit": "good",
   "proposed": false
  },
  {
   "id": "q7",
   "type": "PRC/synthesis",
   "label": "Pre-polymerise each epoxy with APTES at 40 C, 3 h, N2 (epoxy ring opening by amine)",
   "attrs": {
    "technique": "prepolymerisation"
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": true,
