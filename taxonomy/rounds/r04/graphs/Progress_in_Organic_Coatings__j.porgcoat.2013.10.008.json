  {
   "id": "p1",
   "type": "HYP/need",
   "label": "Steel needs better corrosion protection; plain epoxy coatings let water, oxygen and chloride reach the metal",
   "attrs": {
    "inferred": true
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
   "spine": true,
