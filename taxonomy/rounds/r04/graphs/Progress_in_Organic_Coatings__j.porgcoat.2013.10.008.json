   "proposed": false
  },
  {
   "id": "p2",
   "type": "HYP/hypothesis",
   "label": "PANI (active passivation) plus exfoliated clay (barrier) in epoxy should protect steel better; hydrophobic OMMT should beat MMT",
   "attrs": {
    "inferred": true
   },
   "figs": [],
   "modality": null,
   "provenance": null,
   "image_support": null,
