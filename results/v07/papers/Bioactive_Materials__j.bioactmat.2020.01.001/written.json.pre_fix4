     "hidden": true,
     "text": "Observation: Si-HA (002) and (211) peaks sit slightly left of the dashed HA positions (a few hundredths of a degree)"
    },
    {
     "step": 4,
     "role": "claim",
     "nodes": [
      "n11"
     ],
     "depends_on": [
      3
     ],
     "hidden": true,
     "text": "Claim it establishes: Si substitution distorts the HA lattice: reflections shift to lower angle and the a-axis lengthens slightly (9.425 to 9.437 A)"
    },
    {
     "step": 5,
     "role": "downstream",
     "nodes": [
      "n12",
